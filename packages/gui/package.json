{
  "name": "@akabeko/music-metadata-editor-gui",
  "description": "Electron desktop application for @akabeko/music-metadata-editor.",
  "version": "1.1.0",
  "author": "akabeko (http://akabeko.me/)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akabekobeko/npm-music-metadata-editor.git",
    "directory": "packages/gui"
  },
  "bugs": {
    "url": "https://github.com/akabekobeko/npm-music-metadata-editor/issues"
  },
  "homepage": "https://github.com/akabekobeko/npm-music-metadata-editor/tree/main/packages/gui#readme",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "pnpm build:main && pnpm build:preload && pnpm build:renderer",
    "build:main": "vite build --config src/main/vite.config.ts",
    "build:preload": "vite build --config src/preload/vite.config.ts",
    "build:renderer": "vite build --config src/renderer/vite.config.ts",
    "clean": "rm -rf dist release coverage",
    "typecheck": "tsc --build && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "package": "pnpm build && electron-builder",
    "sync-targets": "node scripts/sync-electron-targets.ts",
    "shadcn": "node scripts/shadcn.ts"
  },
  "dependencies": {
    "@akabeko/music-metadata-editor": "workspace:*"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^9.1.2",
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.17.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
